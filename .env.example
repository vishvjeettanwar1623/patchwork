OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: Provide a comma-separated list of multiple OpenRouter API keys to rotate keys and avoid rate limits
OPENROUTER_API_KEYS=key1,key2,key3
OPENROUTER_MODEL=your_model_name_here

# Optional: Add your GitHub credentials here for 100% headless/automated runs
GITHUB_USERNAME=your_github_username_here
GITHUB_PAT=your_github_pat_here
