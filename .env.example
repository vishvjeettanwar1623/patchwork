# OpenRouter AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: Custom model name (e.g., nvidia/nemotron-3-ultra-550b-a55b:free, meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional: Set to true to disable AI commit messages and use local templates instead
DISABLE_AI=false

# GitHub Credentials (Optional: For automated/headless runs)
GITHUB_USERNAME=your_github_username_here
GITHUB_PAT=your_github_pat_here
GITHUB_EMAIL=your_github_email_here
